# Per-project deployment values. The ONLY file that differs between projects —
# every script in this directory reads it and nothing else.

APP_NAME=leuk
AWS_REGION=us-east-1
DOMAIN=leuk.nysgpt.com

# Task size. Next 16 SSR with streaming and a 116k-row directory: 1 vCPU / 2 GB
# is comfortable. Measure before changing — the temptation is always to
# over-provision, and Fargate bills for what you reserve, not what you use.
CPU=1024
MEMORY=2048

# Two tasks so a rolling deploy is not an outage, and one AZ failure is not
# either. This is the single biggest reliability lever here and it costs one
# extra task.
DESIRED_COUNT=2

# Graviton. Same price/performance story as everywhere else on AWS: ~20% cheaper
# for identical work. The image must be built for it — CodeBuild's ARM image is,
# and buildspec.yml pins it.
ARCH=ARM64

# What the ALB polls. Root renders without a session and touches the database,
# so it fails when the database is unreachable — which is what a health check is
# supposed to notice. A static /api/health would pass while the app was useless.
HEALTHCHECK_PATH=/

# Container port. Matches the Dockerfile's PORT.
CONTAINER_PORT=3000
