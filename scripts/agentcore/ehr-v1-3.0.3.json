{
  "openapi": "3.0.3",
  "info": {
    "title": "EHR Reference API",
    "version": "1.0.0",
    "description": "Public-record reference data for New York behavioral health: negotiated rates from payers' federally mandated machine-readable files, credentialing presence from payers' own published provider directories, and the NY provider directory (NPPES + NY Medicaid).\n\nContains NO patient data. Every endpoint reads a reference database that is physically separate from any clinical record."
  },
  "servers": [
    {
      "url": "https://leuk.nysgpt.com",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/rates/bands": {
      "get": {
        "operationId": "getRateBands",
        "summary": "Negotiated rate bands for CPT codes",
        "description": "The 25th percentile, median and 75th percentile of what New York payers publish they pay for a billing code, per payer network. Use this to answer 'what does this code pay' or 'am I paid fairly'. Rates are what the INSURER published, as of a date - not a guarantee, not revenue, not a patient price. Always name the payer when quoting one.",
        "parameters": [
          {
            "name": "codes",
            "in": "query",
            "required": true,
            "description": "Comma-separated 5-digit CPT codes, max 20.",
            "schema": {
              "type": "string"
            },
            "example": "90837,90834"
          },
          {
            "name": "minClinicians",
            "in": "query",
            "required": false,
            "description": "Minimum clinicians a band must cover to be reported. Default 3.",
            "schema": {
              "type": "integer"
            },
            "example": 3
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/api/v1/rates/standing": {
      "get": {
        "operationId": "getProviderStanding",
        "summary": "What payers publish they pay one provider",
        "description": "Every published rate attached to this NPI, grouped by the billing group (TIN) it was filed under. Use this to answer 'what am I paid' for a specific clinician before comparing against the bands.",
        "parameters": [
          {
            "name": "npi",
            "in": "query",
            "required": true,
            "description": "10-digit National Provider Identifier.",
            "schema": {
              "type": "string"
            },
            "example": "1234567890"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/api/v1/rates/placement": {
      "get": {
        "operationId": "getPercentilePlacement",
        "summary": "Where one group's rate sits in the band",
        "description": "Given a payer, a billing code and a billing group (TIN), where that group's published rate falls in the New York band - for example 'below the 25th percentile'. Returns null when too few clinicians exist for the comparison to be meaningful; say so rather than guessing.",
        "parameters": [
          {
            "name": "payer",
            "in": "query",
            "required": true,
            "description": "Payer name exactly as returned by the bands or standing endpoints.",
            "schema": {
              "type": "string"
            },
            "example": "Aetna Life Insurance Company"
          },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "A 5-digit CPT code.",
            "schema": {
              "type": "string"
            },
            "example": "90837"
          },
          {
            "name": "tin",
            "in": "query",
            "required": true,
            "description": "The billing group's Taxpayer Identification Number.",
            "schema": {
              "type": "string"
            },
            "example": "123456789"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/api/v1/credentialing/footprint": {
      "get": {
        "operationId": "getCredentialingFootprint",
        "summary": "Which payer directories list this provider",
        "description": "Which payer books this NPI appears in, under which billing groups, and which checked books it is ABSENT from. Use this for credentialing questions: has a listing dropped, is a panel missing, is the practice invisible in a plan's search.\n\nCritical distinction: 'listed in a payer's directory' is NOT the same claim as 'in-network', which is NOT the same as 'accepting new patients'. Never upgrade one into the other. Always give the source and as-of date.",
        "parameters": [
          {
            "name": "npi",
            "in": "query",
            "required": true,
            "description": "10-digit National Provider Identifier.",
            "schema": {
              "type": "string"
            },
            "example": "1234567890"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/api/v1/networks/participation": {
      "get": {
        "operationId": "getNetworkParticipation",
        "summary": "Payer networks a provider is listed in",
        "description": "Every payer network this NPI appears in, with the payer's own as-of date and, where the payer publishes it, whether they are accepting new patients. Absence of an accepting flag means the payer does not publish one - not that they are closed.",
        "parameters": [
          {
            "name": "npi",
            "in": "query",
            "required": true,
            "description": "10-digit National Provider Identifier.",
            "schema": {
              "type": "string"
            },
            "example": "1234567890"
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/api/v1/providers/search": {
      "get": {
        "operationId": "searchProviders",
        "summary": "Search the NY behavioral-health provider directory",
        "description": "~126,000 New York providers from NPPES and NY Medicaid, with profession, subspecialty and location. Use to find a provider's NPI before calling the rate or credentialing endpoints, or to answer directory questions. If a search returns nothing, say so and suggest loosening a filter - never fill the gap from memory.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-text name or practice search.",
            "schema": {
              "type": "string"
            },
            "example": "Cohen"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City name.",
            "schema": {
              "type": "string"
            },
            "example": "Brooklyn"
          },
          {
            "name": "county",
            "in": "query",
            "required": false,
            "description": "NY county.",
            "schema": {
              "type": "string"
            },
            "example": "Kings"
          },
          {
            "name": "profession",
            "in": "query",
            "required": false,
            "description": "Profession label.",
            "schema": {
              "type": "string"
            },
            "example": "Psychologist"
          },
          {
            "name": "subspecialty",
            "in": "query",
            "required": false,
            "description": "Subspecialty label.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerType",
            "in": "query",
            "required": false,
            "description": "One of therapist, psychiatrist, prescriber.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "insurancePayer",
            "in": "query",
            "required": false,
            "description": "Keep only providers listed in this payer's directory (payer slug).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-based page number. Default 1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Results per page, max 50. Default 20.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    }
  }
}