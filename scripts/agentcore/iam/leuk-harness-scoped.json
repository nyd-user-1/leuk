{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeAnyBedrockModel",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:638175140432:inference-profile/*",
        "arn:aws:bedrock:*:638175140432:application-inference-profile/*"
      ]
    }
  ]
}